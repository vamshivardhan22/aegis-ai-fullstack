# Aegis AI environment
AEGIS_ENV=development
AEGIS_DEBUG=false

# Database: SQLite for local development
AEGIS_DB_URL=sqlite+aiosqlite:///./aegis.db

# Database: PostgreSQL for Docker/production
# AEGIS_DB_URL=postgresql+asyncpg://aegis:aegis_secret@postgres:5432/aegis
AEGIS_DB_POOL_SIZE=10
AEGIS_DB_MAX_OVERFLOW=20

# Storage
AEGIS_STORAGE_BACKEND=local
AEGIS_LOCAL_STORAGE_PATH=./data
AEGIS_MINIO_ENDPOINT=localhost:9000
AEGIS_MINIO_ACCESS_KEY=minioadmin
AEGIS_MINIO_SECRET_KEY=minioadmin
AEGIS_MINIO_BUCKET=aegis-data
AEGIS_MINIO_SECURE=false

# Services
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_MLFLOW_TRACKING_URI=http://localhost:5000
AEGIS_MLFLOW_EXPERIMENT_NAME=aegis-default
AEGIS_OLLAMA_URL=http://localhost:11434
AEGIS_LLM_MODEL=llama3.1
AEGIS_LLM_FALLBACK=
AEGIS_LLM_TIMEOUT=120

# Security
AEGIS_SECRET_KEY=change-me-in-production
AEGIS_JWT_ALGORITHM=HS256
AEGIS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orchestration
AEGIS_MAX_RETRIES=3
AEGIS_RETRY_DELAY_SECONDS=5
AEGIS_HUMAN_APPROVAL_RISK_THRESHOLD=0.7
